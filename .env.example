TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
JEV_MIN_CONFIDENCE=0.45
JEV_REQUEST_TIMEOUT_MS=25000

# Jev chooses actions but does not generate text. Use any OpenAI-compatible model.
TEXT_MODEL_API_KEY=
TEXT_MODEL=deepseek-chat
TEXT_MODEL_BASE_URL=https://api.deepseek.com/v1

# Optional; defaults to ffmpeg on PATH.
FFMPEG_PATH=ffmpeg
