TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
JEV_MIN_CONFIDENCE=0.45
JEV_REQUEST_TIMEOUT_MS=25000

# Jev chooses actions but does not generate text. Use any OpenAI-compatible model.
TEXT_MODEL_API_KEY=
TEXT_MODEL=deepseek-chat
TEXT_MODEL_BASE_URL=https://api.deepseek.com/v1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING=low

# Optional generic overrides used by --llm. Provider: openai, anthropic, or ollama.
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_REASONING=
LLM_REQUEST_TIMEOUT_MS=120000

# Anthropic is auto-detected when no generic/OpenAI configuration is present.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# For local Ollama chat models, set LLM_PROVIDER=ollama and LLM_MODEL.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=

# Optional; defaults to ffmpeg on PATH.
FFMPEG_PATH=ffmpeg
